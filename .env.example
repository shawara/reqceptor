# Backend Configuration
PORT=3001
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend-domain.com

# Optional Redis — WARNING (Render free tier): traffic to external Redis (e.g. Upstash)
# counts as "Service-Initiated" bandwidth and can exhaust the 5GB limit quickly.
# Prefer leaving Redis OFF on free Render; data lives in memory until the service sleeps/restarts.
# REDIS_URL=rediss://default:TOKEN@YOUR_HOST.upstash.io:6379
# REQUESTS_REDIS=false
# FORWARDING_REDIS=false
#
# If you must use Redis, enable only one store:
# REQUESTS_REDIS=true
# FORWARDING_REDIS=false
# MAX_REQUESTS_PER_WEBHOOK=25
# MAX_FORWARD_URLS=20

# Frontend Configuration  
VITE_API_URL=http://localhost:3001
